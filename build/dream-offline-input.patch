     }
-    if (bNewBlocking)
+    if (bNewBlocking && (eFmt == fmt_txt || !offlineWaveInput()))
     {
         double interval = double(iNewBufferSize/2) / double(iNewSampleRate);
         pacer = new CPacer(uint64_t(1e9*interval));
@@ -277,6 +288,16 @@
         sf_count_t c = sf_readf_short((SNDFILE*)pFileReceiver, &buffer[iReadFrame * iFileChannels], iRemainingFrame);
 	    if (c != sf_count_t(iRemainingFrame))
 	    {
+            if (offlineWaveInput()) {
+                const bool failed = sf_error((SNDFILE*)pFileReceiver) != 0;
+                if (failed || c <= 0)
+                    throw OfflineInputEnd{failed};
+                // Retain the last partial block. The next read reports EOF.
+                const int remainder = iRemainingFrame - int(c);
+                std::memset(&buffer[(iReadFrame + c) * iFileChannels], 0,
+                            remainder * iFileChannels * sizeof(*buffer));
+                break;
+            }
