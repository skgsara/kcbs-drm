 #include <string.h>
 
 using namespace std;
+
+static bool offlineWaveInput()
+{
+#if defined(QT_CORE_LIB) || !defined(HAVE_LIBSNDFILE)
+    // The single-pass EOF handler belongs to the native console receiver.
+    return false;
+#else
+    const char* setting = std::getenv("DREAM_FILE_OFFLINE");
+    return setting && std::strcmp(setting, "1") == 0;
+#endif
+}
 
 CAudioFileIn::CAudioFileIn(): CSoundInInterface(), eFmt(fmt_other),
     pFileReceiver(nullptr), iSampleRate(0), iRequestedSampleRate(0), iBufferSize(0),
@@ -179,7 +190,7 @@
         delete pacer;
